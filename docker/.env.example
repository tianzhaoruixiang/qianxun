# ────────────── 千寻一键编排环境变量模板（复制为 .env 后修改） ──────────────
# 文件位置：docker/.env  （会被 docker-compose 自动加载）
# 真实密钥请勿提交到 VCS（已在根 .gitignore 屏蔽 docker/.env）

# ============== Doris ==============
DORIS_FE_TAG=fe-4.0.2
DORIS_BE_TAG=be-4.0.2
DORIS_FE_HTTP_PORT=8030
DORIS_FE_QUERY_PORT=9030
DORIS_BE_WEBSERVER_PORT=8040
DORIS_USER=root
DORIS_PASSWORD=
# 自定义内部子网（与宿主已有 docker 网络冲突时改这里）
DORIS_SUBNET=172.29.80.0/24

# ============== Hermes Agent ==============
HERMES_IMAGES=nousresearch/hermes-agent:latest
HERMES_API_PORT=8642
HERMES_MEM_LIMIT=4G
HERMES_CPU_LIMIT=2.0
# 后端访问 Hermes 用的 Bearer Token（必须与容器内 API_SERVER_KEY 一致）
API_SERVER_KEY=qianxun-local-dev-key
# Kimi / Moonshot 中国站
KIMI_API_KEY=sk-replace-me
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ============== 千寻应用 ==============
QIANXUN_BACKEND_PORT=8080
QIANXUN_FRONTEND_PORT=5173
QIANXUN_TAG=dev
# 是否启用 Hermes（关闭则后端走 mock 流式输出）
QIANXUN_HERMES_ENABLED=true
QIANXUN_HERMES_CHAT_MODEL=hermes-agent
QIANXUN_HERMES_NLU_ENABLED=true

# ============== 兜底 LLM（可选，未启用 Hermes 或 Hermes 失败时使用） ==============
OPENAI_API_KEY=
QIANXUN_LLM_BASE_URL=https://api.openai.com/v1
QIANXUN_LLM_MODEL=gpt-4o-mini
QIANXUN_LLM_MOCK=true

# ============== JVM ==============
JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+UseG1GC"
