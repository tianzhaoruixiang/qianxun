# ────────────── 千寻一键编排环境变量模板（复制为 .env 后修改） ──────────────
# 文件位置：docker/.env  （会被 docker-compose 自动加载）
# 真实密钥请勿提交到 VCS（已在根 .gitignore 屏蔽 docker/.env）
# 镜像名称与版本写在 docker-compose.yml，不在此文件。

# ============== ARM64 主机（Apple Silicon 等）必读 ==============
# 当前 compose 默认镜像是 arm64-dev。常见 Windows PC 是 amd64，需改 docker-compose.yml 中的镜像标签。
# 若要连 TiDB 一起清空：./bin/destroy-data.sh --yes [--all] && ./bin/up.sh

# ============== 内部网段 ==============
# 与宿主已有 Docker 网络冲突时改这里
QIANXUN_NET_SUBNET=172.29.80.0/24
QIANXUN_NET_IP_RANGE=172.29.80.128/25
QIANXUN_NET_GATEWAY=172.29.80.1

# ============== TiDB ==============
TIDB_PORT=4000
TIDB_STATUS_PORT=10080
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DB_URL=jdbc:mysql://tidb:4000/qianxun?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&useSSL=false&rewriteBatchedStatements=true&allowMultiQueries=true

# ============== MinIO ==============
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=qianxun
MINIO_ROOT_PASSWORD=qianxun-minio-dev
MINIO_ENDPOINT=http://minio:9000
MINIO_CLAUDE_BUCKET=claudecode
MINIO_UPLOAD_BUCKET=qianxun
# 直接 compose up 保持 0；./bin/up.sh 在 HOST_S3FS=1 时会覆盖为 1
CLAUDE_SEED_MIGRATE=0
# Claude Code 工作区默认经宿主 s3fs 进 MinIO 桶 claudecode（Linux / OpenEuler）
# Windows / 无 FUSE：HOST_S3FS=0
HOST_S3FS=1
# HOST_S3FS_URL=http://127.0.0.1:9000

# ============== Claude Code SDK 网关（独立 sidecar） ==============
CLAUDE_CODE_PORT=8642
# AIO Dashboard / VNC / Jupyter（容器内 8080）；避开后端宿主 8080
AIO_SANDBOX_PORT=8088
# 内网一般不需要 Jupyter / code-server；设为 true 可减资源（不影响 Claude 对话网关 8642）
DISABLE_JUPYTER=false
DISABLE_CODE_SERVER=false
# 内网 Bearer；生产务必设置非空值并将 CLAUDE_GATEWAY_ALLOW_INSECURE=false
# 本地开发可留空并依赖 CLAUDE_GATEWAY_ALLOW_INSECURE=true（docker-compose 默认）
CLAUDE_GATEWAY_KEY=
CLAUDE_GATEWAY_ALLOW_INSECURE=true

# 上游：默认 OpenAI Compatible（sidecar → LiteLLM → 百炼 / 内网网关 /v1）
# 直接 `docker compose up -d` 即可；勿把 ANTHROPIC_BASE_URL 指到厂商 /v1 或 /apps/anthropic
# CLAUDE_UPSTREAM_MODE 仅 up.sh / verify.sh 读取
CLAUDE_UPSTREAM_MODE=openai

LITELLM_PORT=4001
LITELLM_MASTER_KEY=sk-litellm-local
LITELLM_MODEL_ALIAS=openai-default
LITELLM_UPSTREAM_MODEL=openai/qwen3.6-plus
LITELLM_LOG=INFO
OPENAI_UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 厂商 OpenAI Compatible 密钥（只给 LiteLLM）
OPENAI_UPSTREAM_API_KEY=

# ── 内网 DeepSeek 示例（改上面三行，不要改 ANTHROPIC_BASE_URL）──
# OPENAI_UPSTREAM_BASE_URL=http://10.x.x.x:<port>/v1
# 若网关跑在宿主机本机：用 host.docker.internal，不要用 127.0.0.1（容器里的 localhost 不是宿主）
# OPENAI_UPSTREAM_BASE_URL=http://host.docker.internal:8000/v1
# LITELLM_UPSTREAM_MODEL=openai/DeepseekV4Flash
# OPENAI_UPSTREAM_API_KEY=<内网密钥>
# QIANXUN_CLAUDE_MODEL 仍用 openai-default（或 DeepseekV4Flash / DeepSeek-V4-Flash，LiteLLM 已有同名别名）

# Claude Agent SDK → LiteLLM（必须是容器内地址 http://litellm:4000，密钥是 master key）
# 不要写成 http://127.0.0.1:3456（Claude Code Router 本机默认；容器里的 127.0.0.1 不是宿主机）
ANTHROPIC_API_KEY=sk-litellm-local
ANTHROPIC_AUTH_TOKEN=sk-litellm-local
ANTHROPIC_BASE_URL=http://litellm:4000
ANTHROPIC_MODEL=openai-default

QIANXUN_CLAUDE_ENABLED=true
QIANXUN_CLAUDE_BASE_URL=http://claude-code:8642
QIANXUN_CLAUDE_MODEL=openai-default
QIANXUN_CLAUDE_PERMISSION_MODE=bypassPermissions
QIANXUN_CLAUDE_CONTEXT_WINDOW=200000
# OpenAI Compatible 上游务必 disabled；LiteLLM 已强制 /v1/messages → chat/completions
QIANXUN_CLAUDE_THINKING=disabled

# ============== 千寻应用 ==============
QIANXUN_BACKEND_PORT=8080
QIANXUN_FRONTEND_PORT=80
# 用户上传文档：sidecar 访问公开下载链接用的后端地址（容器内服务名）
QIANXUN_FILE_PUBLIC_BASE_URL=http://qianxun-backend:8080
QIANXUN_UPLOAD_MAX_MB=50
QIANXUN_CORS_ALLOWED_ORIGIN_PATTERNS=*

# ============== 兜底 LLM（未启用 Claude Code 时使用） ==============
OPENAI_API_KEY=
QIANXUN_LLM_BASE_URL=https://api.openai.com/v1
QIANXUN_LLM_MODEL=gpt-4o-mini
QIANXUN_LLM_MOCK=true
# 流式回答：避免长文被截断 / 连接过早超时（千寻后端 qianxun.llm.*）
# STREAM_TIMEOUT 0 = 不限制整段墙钟超时（智能体工具循环可能很长）
QIANXUN_LLM_MAX_TOKENS=16384
QIANXUN_LLM_STREAM_TIMEOUT_SECONDS=0

# ============== JVM ==============
JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+UseG1GC"
